.env
.profiles
.venv
.venv_test
env/
venv/
ENV/
env.bak/
venv.bak/

#mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype
.pytype/

# Cython debug symbols
cython_debug/

# Editor / OS metadata
.vscode/
.idea/
.DS_Store

# Docker
docker/

# ZED
.zed/

# Vim
.vim/

# Nessy CLI local settings (keep output-language.md if needed)
.nessy/settings.json

# Содержимое config кроме .gitkeep игнорируется
/config/*
!/config/.gitkeep

# Локальные промпты с личными данными (контакты, ставка) — не коммитятся
prompts/*.local.txt
prompts/*.local.md

Session.vim

