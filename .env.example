# Copy to .env. Do not commit real credentials, tokens or personal contacts.

# Optional text personalization used only in rendered prompts.
HH_NAME=
HH_TELEGRAM=

# One account needs no HH_PROFILE_ID. For several accounts use .profiles.
# HH_PROFILE_ID=account2
# Ten accounts can run concurrently by default.
HH_PROFILE_PARALLELISM=10

# Runtime paths
CONFIG_DIR=/app/config
LOG_DIR=/app/config
LOG_LEVEL=INFO

# Autonomous scheduler safety switch:
#   off      -> cron does nothing (default)
#   dry-run  -> scheduled jobs inspect only
#   live     -> scheduled apply/reply/boost perform external writes
HH_AUTOMATION_MODE=off

# Daily application batch
SEARCH_QUERY=Frontend разработчик
APPLY_LIMIT=100
APPLY_PER_PAGE=50
APPLY_PAGES=20
APPLY_RUN_TIMEOUT=3600
# One exclusion regex per line. This file is tracked and is the default hard filter.
# Leave empty to disable vacancy exclusion filters.
APPLY_HARD_FILTER_FILE=
# Optional emergency inline override. Leave empty to use APPLY_HARD_FILTER_FILE.
EXCLUDED_FILTER=

# Hourly chat pass
REPLY_CHATS=100
# Optional repeated scans within one run; each scan checks the latest employer message.
REPLY_ROUNDS=1
REPLY_ROUND_INTERVAL=60

# Optional emails after successful HH applications. Uses HH_GMAIL_DIR if set,
# otherwise smtp in each profile config. The directory must contain the local
# Gmail API config.json, credentials.json, and token.json OAuth files.
APPLY_SEND_EMAIL=1
# HH_GMAIL_DIR=/path/to/local-gmail-oauth
# Temporary workaround for a captcha AI provider with an invalid certificate.
# Scope is captcha AI only; restore 1 when the provider certificate is fixed.
HH_CAPTCHA_VERIFY_SSL=1
# Text generation uses the local OpenCode login, not profile API keys.
# The profile API key is reserved for direct CAPTCHA vision requests.
HUMANIZER_OPENCODE_MODEL=openai/gpt-5.6-luna
# Shared anti-spam ledger for all profiles. Defaults to CONFIG_DIR/global_email_sends.sqlite.
# HH_EMAIL_LEDGER_PATH=/path/to/shared/global_email_sends.sqlite

# Daily rejected-negotiation cleanup. 1 also hides the rejected HH web chat.
CLEANUP_DELETE_CHAT=1

# Container/server timezone used by cron
TZ=Europe/Moscow

# Admin authentication. Configure both values before exposing port 8000 beyond localhost.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional proxies
# HTTP_PROXY=
# HTTPS_PROXY=

# Browser authorization options
HEADLESS=true
BROWSER_TIMEOUT=30000
